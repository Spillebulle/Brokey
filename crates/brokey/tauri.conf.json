{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Brokey",
  "version": "0.1.5",
  "identifier": "io.github.spillebulle.brokey",
  "build": {
    "beforeDevCommand": { "script": "npm run dev", "cwd": "../.." },
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": { "script": "npm run build", "cwd": "../.." },
    "frontendDist": "../../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Brokey",
        "label": "main",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' asset: http://asset.localhost https: data:; connect-src 'self' ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "/usr/share/swcatalog/**",
          "/var/lib/swcatalog/**",
          "/usr/share/app-info/**",
          "/var/lib/app-info/**",
          "/var/lib/flatpak/**",
          "/var/lib/snapd/**",
          "/usr/share/icons/**",
          "/usr/share/pixmaps/**",
          "$HOME/.local/share/flatpak/**",
          "$CACHE/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "category": "Utility",
    "shortDescription": "One store for every way a machine gets software",
    "linux": {
      "appimage": { "bundleMediaFramework": false }
    }
  }
}
