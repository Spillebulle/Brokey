<?xml version="1.0" encoding="utf-8"?>
<!-- Invented for this test only. Every real package on the reference
     machine's C:\ProgramData\chocolatey\lib carries a <title>, so there is
     no genuine .nuspec to copy for the no-title fallback; this one is
     written by hand purely to exercise that path. -->
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>no-title-example</id>
    <version>1.0.0</version>
    <authors>Nobody</authors>
    <description>A minimal package with no title element, for the fallback test.</description>
  </metadata>
</package>
