{
  "folders": {
    "ProgramFiles": "C:\\Program Files",
    "ProgramFilesX86": "C:\\Program Files (x86)",
    "ProgramData": "C:\\ProgramData",
    "AppData": "C:\\Users\\you\\AppData\\Roaming",
    "LocalAppData": "C:\\Users\\you\\AppData\\Local",
    "LocalLow": "C:\\Users\\you\\AppData\\LocalLow",
    "Documents": "C:\\Users\\you\\Documents",
    "SavedGames": "C:\\Users\\you\\Saved Games",
    "StartMenuMachine": "C:\\ProgramData\\Microsoft\\Windows\\Start Menu\\Programs",
    "StartMenuUser": "C:\\Users\\you\\AppData\\Roaming\\Microsoft\\Windows\\Start Menu\\Programs",
    "Desktop": "C:\\Users\\you\\Desktop",
    "Windows": "C:\\Windows",
    "Profile": "C:\\Users\\you"
  },
  "dirs": {
    "C:\\": [
      { "name": "Program Files", "is_dir": true },
      { "name": "Users", "is_dir": true },
      { "name": "Windows", "is_dir": true }
    ],
    "C:\\Program Files": [{ "name": "Other", "is_dir": true }],
    "C:\\Program Files\\Other": [{ "name": "other.exe", "size": 100 }],
    "C:\\Users\\you": [
      { "name": "Desktop", "is_dir": true },
      { "name": "Downloads", "is_dir": true }
    ],
    "C:\\Users\\you\\Downloads": [
      { "name": "setup.exe", "size": 100 },
      { "name": "tool", "is_dir": true }
    ],
    "C:\\Users\\you\\Downloads\\tool": [{ "name": "tool.exe", "size": 100 }],
    "C:\\Users\\you\\AppData\\Roaming": [{ "name": "Widget Maker", "is_dir": true }],
    "C:\\Users\\you\\AppData\\Roaming\\Widget Maker": [{ "name": "prefs.json", "size": 10 }],
    "C:\\ProgramData\\Microsoft\\Windows\\Start Menu\\Programs": [{ "name": "Other.lnk", "size": 1000 }],
    "C:\\Users\\you\\Desktop": [
      { "name": "Gone.lnk", "size": 1000 },
      { "name": "Other.lnk", "size": 1000 }
    ]
  },
  "shortcuts": {
    "C:\\ProgramData\\Microsoft\\Windows\\Start Menu\\Programs\\Other.lnk": "C:\\Program Files\\Other\\missing.exe",
    "C:\\Users\\you\\Desktop\\Gone.lnk": "C:\\Users\\you\\Downloads\\gone.exe",
    "C:\\Users\\you\\Desktop\\Other.lnk": "C:\\Program Files\\Other\\missing.exe"
  },
  "registry": {
    "Hkcu": {
      "Software\\Microsoft\\Windows\\CurrentVersion\\Run": {
        "values": [
          ["Tool", "C:\\Users\\you\\Downloads\\tool\\tool.exe"],
          ["Other", "\"C:\\Program Files\\Other\\other.exe\""]
        ]
      }
    },
    "Hklm": {
      "Software\\Microsoft\\Windows\\CurrentVersion\\App Paths": { "subkeys": ["other.exe"] },
      "Software\\Microsoft\\Windows\\CurrentVersion\\App Paths\\other.exe": {
        "values": [["", "C:\\Program Files\\Other\\other.exe"]]
      }
    }
  },
  "services": [{ "name": "OtherSvc", "image_path": "\"C:\\Program Files\\Other\\other.exe\" --service" }],
  "tasks": [{ "path": "\\Other Update", "actions": ["C:\\Program Files\\Other\\other.exe"] }],
  "firewall": [
    { "name": "Other", "program": "C:\\Program Files\\Other\\other.exe" },
    { "name": "Tool", "program": "C:\\Users\\you\\Downloads\\tool\\tool.exe" }
  ]
}
