# Maintainer: Spillebulle <spillebulle@gmail.com>
#
# The Arch package built from the release binaries, attached to every release
# as brokey-bin-<version>-1-x86_64.pkg.tar.zst. `-bin` because that is what
# Arch calls a package of a compiled artefact; the from-source package is the
# PKGBUILD beside this one. The workflow fills in pkgver.

pkgname=brokey-bin
pkgver=0.1.0
pkgrel=1
pkgdesc="One store for every way a Linux machine gets software"
arch=('x86_64' 'aarch64')
url="https://github.com/Spillebulle/Brokey"
license=('GPL-3.0-or-later')
provides=('brokey')
conflicts=('brokey')
# archlinux-appstream-data: names, icons, descriptions and screenshots for
# repository packages; without it only installed applications are recognised.
depends=('webkit2gtk-4.1' 'gtk3' 'polkit' 'curl' 'hicolor-icon-theme' 'archlinux-appstream-data')
optdepends=('paru: build AUR packages with paru'
            'yay: build AUR packages with yay'
            'flatpak: search and install from Flathub'
            'fwupd: firmware updates'
            'chwd: driver profiles on CachyOS')
options=('!strip' '!debug')
# Enrols the machine in the Spillebulle archive, so pacman -Syu upgrades
# Brokey from then on (../Packages/ENROLMENT.md). makepkg wants the file
# beside this PKGBUILD; the release workflow copies it there.
install=brokey.install
source_x86_64=("brokey-${pkgver}-x86_64-unknown-linux-gnu.tar.gz")
source_aarch64=("brokey-${pkgver}-aarch64-unknown-linux-gnu.tar.gz")
sha256sums_x86_64=('SKIP')
sha256sums_aarch64=('SKIP')

package() {
    local stage
    stage=$(find "$srcdir" -maxdepth 1 -type d -name 'brokey-*' | head -1)
    local id=io.github.spillebulle.brokey
    install -Dm755 "$stage/brokey" "$pkgdir/usr/bin/brokey"
    install -Dm755 "$stage/brokey-helper" "$pkgdir/usr/lib/brokey/brokey-helper"
    install -Dm644 "$stage/packaging/$id.policy" "$pkgdir/usr/share/polkit-1/actions/$id.policy"
    install -Dm644 "$stage/packaging/$id.desktop" "$pkgdir/usr/share/applications/$id.desktop"
    install -Dm644 "$stage/packaging/$id.metainfo.xml" "$pkgdir/usr/share/metainfo/$id.metainfo.xml"
    for size in 16 32 48 64 128 256; do
        install -Dm644 "$stage/icons/brokey-$size.png" \
            "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/$id.png"
    done
    # The archive key under Brokey's own name; brokey.install trusts it. The
    # release tarball carries packaging/ whole, so the key is in it.
    install -Dm644 "$stage/packaging/linux/spillebulle-archive.asc" \
        "$pkgdir/usr/share/brokey/spillebulle-archive.asc"
    install -Dm644 "$stage/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 "$stage/README.md" "$stage/CHANGELOG.md" -t "$pkgdir/usr/share/doc/brokey/"
}
